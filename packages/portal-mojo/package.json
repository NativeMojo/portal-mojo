{
    "name": "portal-mojo",
    "version": "0.1.1",
    "description": "React portal toolkit for django-mojo — typed client + params store, mission-control UI, dependency-free SVG charts, admin section bundles.",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NativeMojo/portal-mojo.git",
        "directory": "packages/portal-mojo"
    },
    "homepage": "https://github.com/NativeMojo/portal-mojo#readme",
    "bugs": {
        "url": "https://github.com/NativeMojo/portal-mojo/issues"
    },
    "files": [
        "src",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "provenance": true
    },
    "exports": {
        "./client": "./src/client/index.ts",
        "./client/runtime": "./src/client/runtime.ts",
        "./ui": "./src/ui/index.ts",
        "./ui/shell": "./src/ui/shell.ts",
        "./charts": "./src/charts/index.ts",
        "./admin": "./src/admin/index.ts",
        "./admin/core": "./src/admin/core/index.ts",
        "./admin/registry": "./src/admin/registry.ts",
        "./admin/identity": "./src/admin/public/identity.ts",
        "./admin/security": "./src/admin/public/security.ts",
        "./admin/observability": "./src/admin/public/observability.ts",
        "./admin/operations": "./src/admin/public/operations.ts",
        "./admin/infrastructure": "./src/admin/public/infrastructure.ts",
        "./admin/communications": "./src/admin/public/communications.ts",
        "./admin/assistant": "./src/admin/public/assistant.ts",
        "./admin/assistant/launcher": "./src/admin/public/assistant-launcher.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5",
        "react": "^19",
        "react-dom": "^19",
        "react-router-dom": "^7"
    },
    "devDependencies": {
        "@tanstack/react-query": "^5.62.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.6.1",
        "typescript": "~5.9.3",
        "vite": "^7.1.0"
    }
}
