# `npm run dev:live` (vite --mode live) — the portal against a REAL local
# django-mojo backend instead of the in-memory mock. Point this wherever your
# dev server runs; `npm run dev` stays on the mock.
VITE_MOJO_API=http://localhost:9009

# Sign in on the portal's OWN pages (#/auth/login) instead of bouncing to
# django-mojo's hosted /auth pages. Without this, a configured VITE_MOJO_API
# defaults the guard to 'hosted', so every unauthenticated load leaves the app
# for the bouncer's bot-check interstitial — which makes the C3 auth pages
# untestable against a real backend and stops automated verification cold.
# Set 'hosted' to exercise the redirect + ?auth_code= handoff instead.
VITE_MOJO_AUTH=inapp
