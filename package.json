{
    "name": "portal-mojo-repo",
    "private": true,
    "version": "0.0.0",
    "description": "portal-mojo monorepo — React portal toolkit for django-mojo (packages/) and the base admin portal (apps/)",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w portal",
        "dev:live": "npm run dev:live -w portal",
        "dev:showcase": "npm run dev -w showcase",
        "build": "npm run build -w portal",
        "typecheck": "npm run typecheck -w portal-mojo && npm run typecheck -w portal && npm run typecheck -w showcase",
        "verify:package": "node scripts/verify-package.mjs",
        "verify:packed-package": "node scripts/verify-packed-package.mjs",
        "verify:release": "npm run verify:release-script && npm run typecheck && npm run verify:package && npm run verify:admin-contracts && npm run verify:admin-bundles && npm run verify:packed-package && npm run verify:personas && npm run verify:action-results",
        "release": "node scripts/release.mjs patch",
        "release:minor": "node scripts/release.mjs minor",
        "release:major": "node scripts/release.mjs major",
        "release:publish": "npm publish -w portal-mojo",
        "verify:release-script": "node scripts/verify-release-script.mjs",
        "verify:admin-navigation": "node scripts/verify-admin-navigation.mjs",
        "verify:personas": "node scripts/verify-personas.mjs",
        "verify:action-results": "node scripts/verify-action-results.mjs",
        "verify:admin-entrypoints": "node scripts/verify-admin-entrypoints.mjs",
        "verify:admin-contracts": "node scripts/verify-admin-contracts.mjs",
        "verify:admin-bundles": "node scripts/verify-admin-bundles.mjs",
        "verify:fmt": "node scripts/verify-fmt.mjs",
        "verify:fixed-params": "node scripts/verify-fixed-params.mjs",
        "verify:realtime": "node scripts/verify-realtime.mjs",
        "verify:admin-assistant": "node scripts/verify-admin-assistant.mjs",
        "verify:admin-dashboard": "node scripts/verify-admin-dashboard.mjs",
        "verify:admin-cloudwatch": "node scripts/verify-admin-cloudwatch.mjs",
        "verify:admin-groups": "node scripts/verify-admin-groups.mjs",
        "verify:admin-security-tickets": "node scripts/verify-admin-security-tickets.mjs",
        "verify:admin-incidents": "node scripts/verify-admin-incidents.mjs",
        "verify:admin-rules": "node scripts/verify-admin-rules.mjs",
        "verify:admin-members": "node scripts/verify-admin-members.mjs",
        "verify:admin-users": "node scripts/verify-admin-users.mjs",
        "verify:admin-devices": "node scripts/verify-admin-devices.mjs",
        "verify:admin-jobs": "node scripts/verify-admin-jobs.mjs",
        "verify:admin-network": "node scripts/verify-admin-network.mjs",
        "verify:admin-dns": "node scripts/verify-admin-dns.mjs",
        "verify:admin-dns-records": "node scripts/verify-admin-dns-records.mjs",
        "verify:admin-dns-certificates": "node scripts/verify-admin-dns-certificates.mjs",
        "verify:admin-dns-registrar": "node scripts/verify-admin-dns-registrar.mjs",
        "verify:admin-storage": "node scripts/verify-admin-storage.mjs",
        "verify:admin-shortlinks": "node scripts/verify-admin-shortlinks.mjs",
        "verify:admin-messaging": "node scripts/verify-admin-messaging.mjs",
        "verify:admin-phonehub": "node scripts/verify-admin-phonehub.mjs",
        "verify:admin-push": "node scripts/verify-admin-push.mjs",
        "verify:admin-metrics-explorer": "node scripts/verify-admin-metrics-explorer.mjs",
        "verify:worldmap": "node scripts/verify-worldmap.mjs",
        "verify:form-wizard": "node scripts/verify-form-wizard.mjs",
        "verify:location-address": "node scripts/verify-location-address.mjs",
        "verify:file-upload": "node scripts/verify-file-upload.mjs",
        "verify:upload-ux": "node scripts/verify-upload-ux.mjs",
        "verify:record-attachments": "node scripts/verify-record-attachments.mjs",
        "verify:form-uploads": "node scripts/verify-form-uploads.mjs",
        "verify:image-editor": "node scripts/verify-image-editor.mjs"
    }
}
