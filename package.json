{
    "name": "portal-mojo-repo",
    "private": true,
    "version": "0.0.0",
    "description": "portal-mojo monorepo — React portal toolkit for django-mojo (packages/) and the base admin portal (apps/)",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w portal",
        "dev:live": "npm run dev:live -w portal",
        "dev:showcase": "npm run dev -w showcase",
        "build": "npm run build -w portal",
        "typecheck": "npm run typecheck -w portal-mojo && npm run typecheck -w portal && npm run typecheck -w showcase",
        "verify:admin-navigation": "node scripts/verify-admin-navigation.mjs",
        "verify:admin-groups": "node scripts/verify-admin-groups.mjs",
        "verify:admin-security-tickets": "node scripts/verify-admin-security-tickets.mjs",
        "verify:admin-incidents": "node scripts/verify-admin-incidents.mjs",
        "verify:admin-rules": "node scripts/verify-admin-rules.mjs",
        "verify:admin-members": "node scripts/verify-admin-members.mjs",
        "verify:admin-users": "node scripts/verify-admin-users.mjs",
        "verify:admin-devices": "node scripts/verify-admin-devices.mjs",
        "verify:admin-jobs": "node scripts/verify-admin-jobs.mjs",
        "verify:admin-network": "node scripts/verify-admin-network.mjs",
        "verify:admin-dns": "node scripts/verify-admin-dns.mjs",
        "verify:admin-dns-records": "node scripts/verify-admin-dns-records.mjs",
        "verify:admin-storage": "node scripts/verify-admin-storage.mjs",
        "verify:admin-messaging": "node scripts/verify-admin-messaging.mjs",
        "verify:admin-metrics-explorer": "node scripts/verify-admin-metrics-explorer.mjs",
        "verify:worldmap": "node scripts/verify-worldmap.mjs",
        "verify:form-wizard": "node scripts/verify-form-wizard.mjs",
        "verify:location-address": "node scripts/verify-location-address.mjs"
    }
}
